# --- Base de donnees ---
POSTGRES_USER=ow
POSTGRES_PASSWORD=ow
POSTGRES_DB=ow
# Port expose sur la machine hote (changer si un PostgreSQL local occupe deja 5432)
DB_PORT=5432
DATABASE_URL=postgres://ow:ow@localhost:5432/ow

# --- Serveur ---
PORT=3000
HOST=0.0.0.0
# Secret de signature des jetons de session (changer en prod !)
AUTH_SECRET=change-me-please-32-chars-minimum
# Code d'acces a l'espace admin
ADMIN_CODE=OW2026
# Origines autorisees en dev (le front est servi par le serveur en prod)
CORS_ORIGIN=http://localhost:5173

# --- TLS en direct (optionnel) ---
# En production, Traefik termine le TLS : laisser vide.
# Utile pour tester l'installation de la PWA sur un telephone en reseau local,
# car sans https Chrome refuse le service worker (voir README).
#   mkcert 192.168.1.80 localhost
# TLS_CERT=./certs/192.168.1.80.pem
# TLS_KEY=./certs/192.168.1.80-key.pem

# --- Front (dev uniquement) ---
VITE_API_URL=http://localhost:3000
